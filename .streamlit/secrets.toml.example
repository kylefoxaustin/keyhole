# Private NPU + CNN measured-silicon anchor secrets — schema reference.
#
# This is the schema-reference file. The REAL values live in
# `.streamlit/secrets.toml` (gitignored) — never commit values to this file.
#
# Spec source: personal-ai-framework/docs/private_anchor_secrets_spec.md
# (commit 65bf89c on personal-ai-framework main).
#
# DISCIPLINE RULE: When discussing measurements on chat/bus/git, refer by KEY
# (`npu_llm_anchors.mid_int8.qwen3_30b_a3b_moe.tokps`) not VALUE. Raw numbers
# go directly into the gitignored secrets.toml or are pasted into Streamlit
# Cloud Secrets via the share.streamlit.io UI — never typed into chat.
#
# CONSUMERS on keyhole-backend (this repo):
#   - scripts/build_deck.py --include-private (produces
#     data/output/keyhole_results_PRIVATE.pptx with measured-anchor cells
#     populated; the public default build path is unaffected)
#   - src/anchors/private_anchors.py (the loader — typed dataclasses with
#     graceful None-on-miss; never prints values in logs or exception messages)
#
# CONSUMERS on keyhole-sizer + PAI sizer: separate streamlit apps with their
# own .streamlit/secrets.toml files. Same schema; separate physical files.
#
# CELL COUNT: 9 LLM + 6 CNN = 15 total.

# ─────────────────────────────────────────────────────────────────────────
# LLM anchors — 9 cells (3 tier-precision × 3 models)
# ─────────────────────────────────────────────────────────────────────────
# Headline measurement: `tokps` (decode tokens/sec).
# Bandwidth-derivation inputs: `peak_bw_gbps` × `bw_share_frac` ×
# `bw_efficiency_frac` = achieved BW. Loader's `bytes_per_token(share_override=)`
# re-derives implied bytes-per-token on-demand without re-reading secrets.
# Default `bw_share_frac = 0.75` (25% reserved for non-NPU masters).
# Default `bw_efficiency_frac = 0.70` (matches keyhole methodology — see
# docs/methodology/bw_efficiency_derivation.md).
# `source` ∈ {"measured", "vendor_spec", "projected"} drives the badge color
# in the UI / deck: 🟢 measured / 🟡 vendor_spec / 🟠 projected.

# NPU Mid INT8 — 200 eTOPS INT8 (no FP path)
[npu_llm_anchors.mid_int8.qwen3_30b_a3b_moe]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.mid_int8.qwen25_32b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.mid_int8.qwen25_7b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

# NPU High INT8 — 400 eTOPS INT8 (2× Mid via MAC doubling)
[npu_llm_anchors.high_int8.qwen3_30b_a3b_moe]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.high_int8.qwen25_32b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.high_int8.qwen25_7b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

# NPU High FP — 200 eTOPS BF16/FP16 + FP8 (Mid is INT8-only; High differentiates here)
[npu_llm_anchors.high_fp.qwen3_30b_a3b_moe]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.high_fp.qwen25_32b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

[npu_llm_anchors.high_fp.qwen25_7b_dense]
tokps = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"

# ─────────────────────────────────────────────────────────────────────────
# CNN anchors — 6 cells (2 tier-precision × 3 CNN variants)
# ─────────────────────────────────────────────────────────────────────────
# Headline measurement: `ms_per_inference` (single-frame latency in ms).
# CNN measured INT-only on NPU High; no `high_fp.*` cells.
# `input_resolution` is descriptive metadata — recorded so a reader can match
# the cell to its bake-off context.

# NPU Mid INT8 — CNNs at 4/8-bit weights
[cnn_anchors.mid_int8.resnet50_w4]
ms_per_inference = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"
input_resolution = "224x224"

[cnn_anchors.mid_int8.yolov8n_w4]
ms_per_inference = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"
input_resolution = "640x640"

[cnn_anchors.mid_int8.yolov8n_w8]
ms_per_inference = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"
input_resolution = "640x640"

# NPU High INT8 — same three CNNs at the higher-compute tier
[cnn_anchors.high_int8.resnet50_w4]
ms_per_inference = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"
input_resolution = "224x224"

[cnn_anchors.high_int8.yolov8n_w4]
ms_per_inference = 0.0
peak_bw_gbps = 134.4
bw_share_frac = 0.75
bw_efficiency_frac = 0.70
source = "projected"
input_resolution = "640x640"

[cnn_anchors.high_int8.yolov8n_w8]
ms_per_inference = 0.0
