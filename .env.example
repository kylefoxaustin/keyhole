# Keyhole Configuration
# Copy to .env and fill in your values

# === LLM Backend ===
# Options: anthropic, ollama, skippy
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=your-key-here

# Ollama settings (if using local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Skippy settings (if using your local Skippy instance)
SKIPPY_HOST=http://localhost:8000
SKIPPY_MODEL=mixtral-8x7b

# === Video Processing ===
EXTRACT_FPS=1.0
MAX_FRAMES=0
# 0 = no limit, process entire video

# === YOLO Detection ===
YOLO_MODEL=yolo11x.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cuda:0
# Classes to detect (empty = all). COCO class IDs:
# 0=person, 1=bicycle, 2=car, 3=motorcycle, 5=bus, 7=truck, 14=bird, 15=cat, 16=dog
YOLO_CLASSES=

# === SAM 3 Enrichment ===
SAM3_ENABLED=true
SAM3_DEVICE=cuda:0
# Default concept prompts for enrichment (comma-separated)
SAM3_CONCEPTS=person,vehicle,animal,package,bag,hat,uniform,bicycle,skateboard
# Minimum confidence for SAM 3 concept matches
SAM3_CONFIDENCE=0.3

# === Database ===
DATABASE_URL=sqlite:///data/output/sentinel.db

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8777

# === GPU Profiling ===
PROFILE_GPU=false
PROFILE_OUTPUT=data/output/profile_report.json
